#!/bin/bash
#SBATCH -J {JOBNAME}_bridge
#SBATCH -p {ALIGN_PARTITION}
#SBATCH --time=00:30:00
#SBATCH --mem=8gb
#SBATCH --cpus-per-task=2
#SBATCH -o {OUTDIR}/logs/pack_bridge_%j.out
# af3lis -- BRIDGE job between the align array and packed GPU inference.
# This is the DEFAULT inference route (packing strategy after Mau's bwHelix
# AF3 toolkit): it runs once the align array has finished, groups whatever
# MSAs actually landed on disk into few fat single-bucket GPU jobs, and
# submits them.
#
# Chained with `afterany`, NOT `afterok`, deliberately: one failed align task
# under afterok leaves this job in DependencyNeverSatisfied forever. With
# afterany it always runs, and af3lis.pack excludes + reports the conditions
# whose *_data.json is missing -- a partial align gives partial results plus
# an explicit list of what is missing, instead of a silent hang.
#
# Submitted automatically by `pipeline.py --submit`. To use the legacy
# per-task infer array instead, pass `--array-infer`.
set -euo pipefail
mkdir -p "{OUTDIR}/logs"

# Locate the af3lis install. The rendered path is whatever machine ran the
# build; if you rsynced the build to a cluster, that path is wrong -- so
# AF3LIS_DIR wins when set, and we verify the result rather than trusting it.
PIPE="${{AF3LIS_DIR:-{PIPELINE_DIR}}}"
if [ ! -r "$PIPE/pipeline.py" ]; then
    echo "ERROR: no pipeline.py under PIPE='$PIPE'." >&2
    echo "       Set AF3LIS_DIR to the af3lis_pipeline dir on THIS machine and resubmit." >&2
    exit 3
fi

PY="${{AF3LIS_PYTHON:-python3}}"
echo "NODE=$(hostname) PIPE=$PIPE PY=$PY OUTDIR={OUTDIR}"

cd "$PIPE"

# --- monomer mode: rebuild the pair inputs from the cached chain MSAs -------
# In monomer mode the align array produced one MSA per UNIQUE chain under
# msa/, not one per pair under out/. Reassemble the pairs with Mau's
# merge_af3_multimer before packing. A pair whose chains are missing is
# reported and skipped, so a partial align still yields a partial campaign.
if [ -f "{OUTDIR}/.af3lis_align_mode" ] && \
   head -1 "{OUTDIR}/.af3lis_align_mode" | grep -q monomer; then
    echo "== monomer mode: merging cached chain MSAs into pair inputs =="
    "$PY" -m af3lis.monomer merge "{OUTDIR}" --python "$PY" || {{
        echo "ERROR: merge step failed; nothing to pack" >&2; exit 7; }}
fi

"$PY" pipeline.py --pack --outdir "{OUTDIR}" --target-hours {TARGET_HOURS}

SUBMIT="{OUTDIR}/af3pack/submit_all.sh"
[ -r "$SUBMIT" ] || {{ echo "ERROR: pack produced no $SUBMIT" >&2; exit 4; }}
echo "== submitting packed groups =="
bash "$SUBMIT"

# --- chain the ANALYSE stage onto the groups we just submitted --------------
# This CANNOT be done when the campaign is submitted: the packed group jobs do
# not exist until this bridge runs, so their ids are unknown. Chaining analyse
# on the bridge instead is wrong and was a real bug -- the bridge exits in
# seconds, so analyse fired before inference had even started and died with
# "no models".
IDFILE="{OUTDIR}/af3pack/job_ids.txt"
ANALYSE="{OUTDIR}/analyse.sbatch"
if [ -s "$IDFILE" ] && [ -r "$ANALYSE" ]; then
    DEP=$(tr '\n' ':' < "$IDFILE" | sed 's/^://; s/:$//')
    if [ -n "$DEP" ]; then
        # afterany, not afterok: score whatever finished rather than stranding
        # the stage when one GPU group fails.
        AID=$(sbatch --parsable --dependency=afterany:"$DEP" "$ANALYSE")
        echo "PACK_BRIDGE_ANALYSE job=$AID deps=$DEP"
    else
        echo "WARNING: $IDFILE empty; analyse NOT chained" >&2
    fi
else
    echo "WARNING: no job_ids.txt or analyse.sbatch; analyse NOT chained" >&2
fi
echo "PACK_BRIDGE_EXIT=0"
